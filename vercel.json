  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/mokpo-welfare/:path*",
      "destination": "/mokpo-welfare/index.html"
    },
    {
      "source": "/milyang-6th-week/:path*",
      "destination": "/milyang-6th-week/index.html"
    },
    {
      "source": "/milyang-5th-week/:path*",
      "destination": "/milyang-5th-week/index.html"
    },
    {
      "source": "/jeonnam-maritime/:path*",
      "destination": "/jeonnam-maritime/index.html"
    },
    {
      "source": "/kiamotors-excel/:path*",
      "destination": "/kiamotors-excel/index.html"
    },
    {
      "source": "/nambu-univ/:path*",
      "destination": "/nambu-univ/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
