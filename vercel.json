{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/mokpo-welfare/:match*",
      "destination": "/mokpo-welfare/:match*"
    },
    {
      "source": "/milyang-6th-week/:match*",
      "destination": "/milyang-6th-week/:match*"
    },
    {
      "source": "/milyang-5th-week/:match*",
      "destination": "/milyang-5th-week/:match*"
    },
    {
      "source": "/jeonnam-maritime/:match*",
      "destination": "/jeonnam-maritime/:match*"
    },
    {
      "source": "/kiamotors-excel/:match*",
      "destination": "/kiamotors-excel/:match*"
    },
    {
      "source": "/nambu-univ/:match*",
      "destination": "/nambu-univ/:match*"
    }
  ]
}
